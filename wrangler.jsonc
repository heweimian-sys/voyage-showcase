{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voyage-showcase",
  "main": "dist/server/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "works.wow2333.us.ci",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voyage-showcase-db",
      "database_id": "8ebc7d45-5672-4c23-a104-cdeca2ec3165",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
